# Local backend: no cloud database or storage is required for API smoke checks.
HOST=127.0.0.1
PORT=8000
STORAGE_PATH=./storage
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Bring your own compatible multimodal model and TTS credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
VOLCENGINE_API_KEY=

# Set a strong local admin key before creating an invite.
INVITE_ADMIN_KEY=
WORKER_API_KEY=
BACKEND_URL=http://127.0.0.1:8000
WORKER_POLL_SECONDS=5

# Optional persistence and object storage.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
